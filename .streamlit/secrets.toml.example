# Query Studio — Streamlit secrets template
# On Streamlit Community Cloud: paste the relevant section into
#   App settings → Secrets (TOML format)
# Locally: copy to .streamlit/secrets.toml (never commit that file)

# ── Option A: Google Gemini (recommended — generous free tier) ─────────────
# Get a free API key at https://aistudio.google.com/apikey
# [llm]
# provider = "gemini"
# model    = "gemini-2.5-flash"
# api_key  = "AIzaSy_YOUR_KEY_HERE"

# ── Option B: Groq cloud ───────────────────────────────────────────────────
# Get a free API key at https://console.groq.com
# [llm]
# provider = "groq"
# model    = "llama-3.3-70b-versatile"
# api_key  = "gsk_YOUR_KEY_HERE"

# ── Option C: Remote Ollama (self-hosted, must be internet-accessible) ─────
# [llm]
# provider = "ollama_remote"
# host     = "http://YOUR-SERVER-IP:11434"
# model    = "qwen2.5-coder:7b"
# timeout  = 120
