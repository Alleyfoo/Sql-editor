# Query Studio — Streamlit secrets template
# On Streamlit Community Cloud: paste these values into
#   App settings → Secrets (TOML format)
# Locally: copy to .streamlit/secrets.toml (never commit that file)

[llm]
# Remote Ollama instance reachable from the Cloud runner
provider = "ollama_remote"
host     = "http://YOUR-SERVER-IP:11434"
model    = "qwen2.5-coder:7b"
timeout  = 120
