{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CapabilityManifest",
  "type": "object",
  "required": ["manifest_id", "workers"],
  "additionalProperties": false,
  "properties": {
    "manifest_id": {"type": "string", "minLength": 1},
    "workers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["worker_id", "allowed_task_classes", "accepted_handle_types", "output_handle_type"],
        "additionalProperties": false,
        "properties": {
          "worker_id": {"type": "string", "minLength": 1},
          "allowed_task_classes": {
            "type": "array",
            "items": {"type": "string", "enum": ["pushdown", "hybrid", "python_first", "cleaning_first", "follow_up", "adversarial"]}
          },
          "accepted_handle_types": {"type": "array", "items": {"type": "string"}},
          "output_handle_type": {"type": "string", "enum": ["source", "cleaned_source", "result_table", "summary", "error"]}
        }
      }
    }
  }
}
