{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SourceManifest",
  "type": "object",
  "required": ["source_id", "name", "kind", "path", "schema", "rows_estimate", "header_confidence"],
  "additionalProperties": false,
  "properties": {
    "source_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["csv", "table", "api"]},
    "path": {"type": "string", "minLength": 1},
    "schema": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "enum": ["text", "numeric", "date", "integer", "float"]}
    },
    "rows_estimate": {"type": "integer", "minimum": 0},
    "header_confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
