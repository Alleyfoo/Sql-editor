"""LLM SQL Assistant — heuristic vs LLM comparison tab.

One of three panels in the top-level tabbed app
(``streamlit_app.py``).  Demonstrates the value the LLM adds over the
offline heuristic fast path (``src.heuristic_nl``).  Runs the *same*
natural-language input through both paths and shows the user the two
resulting :class:`~src.query_model.QueryModel` plans side by side.

Safety: nothing on this tab executes SQL.  Both paths produce a
``QueryModel``; the SQL is generated by ``QueryModel.to_sql()`` and shown
to the user for inspection only.  The user clicks "Use this plan" to
hand the chosen plan off to the Studio tab, where the existing
``▶ Run query`` button runs it through the same executor blocklist as
every other query in the app.

Architecture
------------
- The heuristic path is local, free, and runs eagerly on every input.
- The LLM path uses the production ``nl_to_query_model`` entry point,
  with the same ``LLMConfig`` (provider, model, host) the Studio tab is
  using — the ``⚙ LLM`` popover in the header controls all tabs.
- The "Use this plan" button writes the chosen ``QueryModel`` into
  ``st.session_state.model`` / ``st.session_state.last_sql``, also
  writes ``nl_prefill`` (with the LLM's ``model.reply`` summary) so
  the Studio's ask bar is pre-populated, and switches to the Studio
  tab by writing ``st.session_state["main_tabs"] = TAB_STUDIO``.
"""

from __future__ import annotations

import copy
import time
from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional, Tuple

import streamlit as st

from src.config import load_config
from src.executor import ExecutionError, execute
from src.heuristic_nl import HeuristicResult, parse_heuristic
from src.llm.natural_language import (
    LLMConfig,
    LLMError,
    RouteToPythonError,
    load_llm_config,
    make_llm_client,
    nl_to_query_model,
)
from src.query_model import QueryModel
from src.streamlit_app import TAB_STUDIO, state
from src.streamlit_app.demo_dataset import (
    DEMO_DESCRIPTION,
    DEMO_NAME,
    load_demo,
)
from src.streamlit_app.llm_health import probe_ollama
from src.streamlit_app.styles import inject_css


